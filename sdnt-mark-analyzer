totalmark = 0
database = {
    "Shahid" = {
        "Tamil": 87,
        "English": 89,
        "Maths": 92,
        "Science":87,
        "Social Science": 93,
        "Computer Science": 96,
        "Hindi": 95,
        "GK": 27,
    } 
}

print("1 - Show all subject marks\n2 - Show average mark\n3 - Show passed and failed subjects\n4 - Search for a specfic subject's mark\n5 - Update a subject mark\n6 - Add a new subject\n7 - Remove a subject\n8 - Enter a new marks list\n9 - Exit")
select_menu = int(input("=>"))
match select_menu:
    case 1:
        for sub, mark in database.items():
            print(sub,":",mark)
    case 2:
        for mark in database.values():
            totalmark += mark
        average = totalmark / len(database)
        print("Average marks: ", average)
    case 3:
        for sub,mark in database.items():
            if mark >= 32:
                print(sub,":",mark, "PASS")
            else:
                print(sub,":",mark, "FAIL!")
    case 4:
        for sub,mark in database.items():
            searchSubject = input("Enter subject to browse marks: ")
            if searchSubject.lower() in database.keys():
                print(sub,":",mark)
            else:
                print("Subject not found!")
    
    
